<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Active Device Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_section"
                android:textColor="@color/sf_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSettingName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:hint="@string/device_name_hint"
                android:inputType="textCapWords"
                android:textColor="@color/sf_text_primary"
                android:textColorHint="@color/sf_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etSettingLocation"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:hint="@string/device_location_hint"
                android:inputType="textCapWords"
                android:textColor="@color/sf_text_primary"
                android:textColorHint="@color/sf_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_beacon_id_label"
                android:textColor="@color/sf_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSettingAdvAddr"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="@string/device_addr_hint"
                    android:inputType="textNoSuggestions"
                    android:maxLength="8"
                    android:textColor="@color/sf_text_primary"
                    android:textColorHint="@color/sf_text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnCopyAdvAddr"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/settings_copy_id"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_beacon_id_help"
                android:textColor="@color/sf_text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSaveDeviceSettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="@string/settings_save_device" />
        </LinearLayout>

        <!-- Control Visibility Toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_visibility_section"
                android:textColor="@color/sf_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swVisReversal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vis_reversal"
                android:textColor="@color/sf_text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swVisTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vis_timer"
                android:textColor="@color/sf_text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swVisShake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vis_shake"
                android:textColor="@color/sf_text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swVisRgb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vis_rgb"
                android:textColor="@color/sf_text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swVisAux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vis_aux"
                android:textColor="@color/sf_text_primary" />
        </LinearLayout>

        <!-- App Preferences -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_app_section"
                android:textColor="@color/sf_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/theme_label"
                android:textColor="@color/sf_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnThemeDark"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/theme_dark"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnThemeLight"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/theme_light"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnThemeSystem"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/theme_system"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ble_duration_label"
                android:textColor="@color/sf_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDur600"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/ble_dur_600"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDur900"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/ble_dur_900"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDur1200"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/ble_dur_1200"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Backup & API -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_data_section"
                android:textColor="@color/sf_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExportBackup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_export_backup" />

            <Button
                android:id="@+id/btnImportBackup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_import_backup" />

            <Button
                android:id="@+id/btnApiDocs"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_api_docs" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
