<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartFan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sf_accent</item>
        <item name="colorOnPrimary">@color/sf_on_accent</item>
        <item name="colorSurface">@color/sf_surface</item>
        <item name="colorOnSurface">@color/sf_text_primary</item>
        <item name="android:colorBackground">@color/sf_bg</item>
        <item name="android:statusBarColor">@color/sf_bg</item>
        <item name="android:navigationBarColor">@color/sf_bg</item>
    </style>

    <style name="Theme.SmartFan.Translucent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
