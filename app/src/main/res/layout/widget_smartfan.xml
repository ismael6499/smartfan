<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/llWidgetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvWidgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/sf_widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_fan_off"
            android:textColor="@color/sf_widget_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnWidgetFanToggle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_widget_btn"
            android:text="@string/widget_btn_fan_off"
            android:textAllCaps="false"
            android:textColor="@color/sf_widget_text"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnWidgetSpeedDown"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.7"
            android:background="@drawable/bg_widget_btn"
            android:text="@string/widget_btn_spd_down"
            android:textColor="@color/sf_widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetSpeedUp"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.7"
            android:background="@drawable/bg_widget_btn"
            android:text="@string/widget_btn_spd_up"
            android:textColor="@color/sf_widget_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetLightToggle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_widget_btn"
            android:text="@string/widget_btn_light_off"
            android:textAllCaps="false"
            android:textColor="@color/sf_widget_text"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnWidgetAllOff"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_widget_btn"
            android:text="@string/widget_btn_all_off"
            android:textAllCaps="false"
            android:textColor="#F87171"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
