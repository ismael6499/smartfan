<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeviceItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_device_name"
                android:textColor="@color/sf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceItemActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/device_active_badge"
                android:textColor="@color/sf_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeviceItemMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/default_device_location"
            android:textColor="@color/sf_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDeviceItemState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hero_state_off"
            android:textColor="@color/sf_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDeviceItemEdit"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="@string/device_edit"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnDeviceItemDelete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="@string/device_delete"
        android:textColor="@color/sf_danger"
        android:textSize="12sp" />
</LinearLayout>
